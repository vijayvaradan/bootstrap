#!/bin/sh
#
# bootstrap
# -----------------------------------------------------------------------------
# The "one command sets up this machine" entrypoint for vijayvaradan/home
# (private). This script is hosted publicly since it has to run before any
# GitHub auth exists, it's what a fresh machine actually fetches via curl. It
# contains no secrets, just orchestration: install gh, authenticate, clone the
# private dotfiles repo through gh's own authenticated transport (sidesteps
# needing SSH keys just to get the first clone), then hand off to that repo's
# own scripts for everything else.
#
# Usage: curl -fsSL <hosted-url> | sh
# -----------------------------------------------------------------------------
set -eu

REPO_GH=vijayvaradan/home
DEST="$HOME/.home"

log() { printf '\n==> %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# -----------------------------------------------------------------------------
# TOOLCHAINS is required by setup-dev-tools-macos.sh/setup-dev-tools-ubuntu.sh,
# which this script hands off to at the end. Checked here too, first thing,
# so a bad or missing value fails immediately with no prompt, rather than
# after GitHub auth and a repo clone have already happened.
# -----------------------------------------------------------------------------
toolchains_usage() {
	cat >&2 <<'EOF'
TOOLCHAINS is required: a case-insensitive, comma-separated list of the
toolchains to install.

  Valid tokens: RUST NODE GO JVM CPP FLUTTER
  Sentinels:    NONE (install none of them)  ALL (install all of them)

Examples:
  TOOLCHAINS=RUST,GO curl -fsSL <hosted-url> | sh
  curl -fsSL <hosted-url> | TOOLCHAINS=RUST,GO sh
  TOOLCHAINS=NONE curl -fsSL <hosted-url> | sh
EOF
}

if [ -z "${TOOLCHAINS+x}" ]; then
	echo "TOOLCHAINS is not set." >&2
	toolchains_usage
	exit 1
fi

_tc_norm="$(printf '%s' "$TOOLCHAINS" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"
if [ -z "$_tc_norm" ]; then
	echo "TOOLCHAINS is empty." >&2
	toolchains_usage
	exit 1
elif [ "$_tc_norm" != "ALL" ] && [ "$_tc_norm" != "NONE" ]; then
	IFS=','
	for _tc_t in $_tc_norm; do
		case "$_tc_t" in
			RUST|NODE|GO|JVM|CPP|FLUTTER) ;;
			*)
				echo "Unrecognized TOOLCHAINS token: '$_tc_t'" >&2
				toolchains_usage
				exit 1
				;;
		esac
	done
	unset IFS
fi
unset _tc_norm _tc_t

# -----------------------------------------------------------------------------
# MACHINE_OWNER is required by bin/setup-github-ssh, which this script hands
# off to below. Checked here too, same reason as TOOLCHAINS above: fail
# immediately, no prompt, before GitHub auth or a clone has happened.
# -----------------------------------------------------------------------------
machine_owner_usage() {
	cat >&2 <<'EOF'
MACHINE_OWNER is required: VIJAY (personal SSH identity only) or WMG
(personal + work). Case-insensitive. No WMG-only value: the personal key is
what vijayvaradan/home's own remote needs, so every machine gets it regardless.

Examples:
  MACHINE_OWNER=VIJAY curl -fsSL <hosted-url> | sh
  curl -fsSL <hosted-url> | MACHINE_OWNER=VIJAY sh
EOF
}

if [ -z "${MACHINE_OWNER+x}" ]; then
	echo "MACHINE_OWNER is not set." >&2
	machine_owner_usage
	exit 1
fi
_mo_norm="$(printf '%s' "$MACHINE_OWNER" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"
case "$_mo_norm" in
	VIJAY|WMG) ;;
	*)
		if [ -z "$_mo_norm" ]; then
			echo "MACHINE_OWNER is empty." >&2
		else
			echo "Invalid MACHINE_OWNER: '$MACHINE_OWNER'." >&2
		fi
		machine_owner_usage
		exit 1
		;;
esac
unset _mo_norm

case "$(uname -s)" in
	Darwin) OS=macos ;;
	Linux)  OS=linux ;;
	*) echo "Unsupported OS: $(uname -s). This covers macOS and Linux (Ubuntu) only so far." >&2; exit 1 ;;
esac

# -----------------------------------------------------------------------------
log "GitHub CLI"
# -----------------------------------------------------------------------------
if ! have gh; then
	case "$OS" in
	macos)
		if ! have brew; then
			echo "Homebrew is required. Install from https://brew.sh/ then re-run this script." >&2
			exit 1
		fi
		brew install gh
		;;
	linux)
		# Official apt install steps: https://github.com/cli/cli/blob/trunk/docs/install_linux.md
		sudo mkdir -p -m 755 /etc/apt/keyrings
		curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
			| sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
		sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
		sudo mkdir -p -m 755 /etc/apt/sources.list.d
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
			| sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
		sudo apt-get update -qq
		sudo apt-get install -y gh
		;;
	esac
fi

# -----------------------------------------------------------------------------
log "GitHub auth"
# -----------------------------------------------------------------------------
if ! gh auth status >/dev/null 2>&1; then
	echo "Not logged in. This opens a browser-based device-code flow, follow the prompts."
	gh auth login
fi

# -----------------------------------------------------------------------------
log "Clone dotfiles"
# -----------------------------------------------------------------------------
if [ -d "$DEST/.git" ]; then
	echo "Already present at $DEST."
else
	# Explicit https:// URL, not the bare "owner/repo" shorthand: the whole
	# point is to clone via gh's authenticated HTTPS transport before any SSH
	# key exists, and the shorthand form instead uses whatever git_protocol is
	# already configured locally, which could be ssh and defeat that.
	gh repo clone "https://github.com/$REPO_GH" "$DEST"
fi

# -----------------------------------------------------------------------------
log "SSH keys (personal/work identity split)"
# -----------------------------------------------------------------------------
"$DEST/bin/setup-github-ssh"

# -----------------------------------------------------------------------------
log "Symlink dotfiles"
# -----------------------------------------------------------------------------
"$DEST/bin/link-dotfiles"

# -----------------------------------------------------------------------------
log "Install dev toolchain"
# -----------------------------------------------------------------------------
case "$OS" in
	macos) "$DEST/setup-dev-tools-macos.sh" ;;
	linux) "$DEST/setup-dev-tools-ubuntu.sh" ;;
esac

log "Done. Open a fresh shell to pick up the new PATH."
