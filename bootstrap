#!/bin/sh
#
# bootstrap
# -----------------------------------------------------------------------------
# The "one command sets up this machine" entrypoint for vijayvaradan/home
# (private). This script is hosted publicly since it has to run before any
# GitHub auth exists, it's what a fresh machine actually fetches via curl. It
# contains no secrets, just orchestration: install gh, authenticate, clone the
# private dotfiles repo through gh's own authenticated transport (sidesteps
# needing SSH keys just to get the first clone), then hand off to that repo's
# own scripts for everything else: link the dotfiles, set up SSH keys and
# identities (setup-github-ssh), install the toolchain.
#
# Usage: curl -fsSL <hosted-url> | sh
# -----------------------------------------------------------------------------
set -eu

# Everything runs inside main(), called on the last line. Under `curl | sh`,
# sh reads this script from stdin as it goes, so any program that reads stdin
# (a y/N prompt, `vim -es`) would eat the rest of the script. Defining main
# first makes sh read the whole script before anything runs; main then gets
# the terminal as stdin.
main() {

REPO_GH=vijayvaradan/home
PERSONAL_GH="${REPO_GH%%/*}"
DEST="$HOME/.home"

log() { printf '\n==> %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# -----------------------------------------------------------------------------
# TOOLCHAINS is required by setup-dev-tools-macos.sh/setup-dev-tools-ubuntu.sh,
# which this script hands off to at the end. Checked here too, first thing,
# so a bad or missing value fails immediately with no prompt, rather than
# after GitHub auth and a repo clone have already happened.
# -----------------------------------------------------------------------------
toolchains_usage() {
	cat >&2 <<'EOF'
TOOLCHAINS is required: a case-insensitive, comma-separated list of the
toolchains to install.

  Valid tokens: RUST NODE GO JVM CPP FLUTTER
  Sentinels:    NONE (install none of them)  ALL (install all of them)

Examples:
  TOOLCHAINS=RUST,GO curl -fsSL <hosted-url> | sh
  curl -fsSL <hosted-url> | TOOLCHAINS=RUST,GO sh
  TOOLCHAINS=NONE curl -fsSL <hosted-url> | sh
EOF
}

if [ -z "${TOOLCHAINS+x}" ]; then
	echo "TOOLCHAINS is not set." >&2
	toolchains_usage
	exit 1
fi

_tc_norm="$(printf '%s' "$TOOLCHAINS" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"
if [ -z "$_tc_norm" ]; then
	echo "TOOLCHAINS is empty." >&2
	toolchains_usage
	exit 1
elif [ "$_tc_norm" != "ALL" ] && [ "$_tc_norm" != "NONE" ]; then
	IFS=','
	for _tc_t in $_tc_norm; do
		case "$_tc_t" in
			RUST|NODE|GO|JVM|CPP|FLUTTER) ;;
			*)
				echo "Unrecognized TOOLCHAINS token: '$_tc_t'" >&2
				toolchains_usage
				exit 1
				;;
		esac
	done
	unset IFS
fi
unset _tc_norm _tc_t

# -----------------------------------------------------------------------------
# MACHINE_OWNER is required by bin/setup-github-ssh, which this script hands
# off to below. Checked here too, same reason as TOOLCHAINS above: fail
# immediately, no prompt, before GitHub auth or a clone has happened.
# -----------------------------------------------------------------------------
machine_owner_usage() {
	cat >&2 <<'EOF'
MACHINE_OWNER is required: VIJAY (personal SSH identity only) or WMG
(personal + work). Case-insensitive. No WMG-only value: the personal key is
what vijayvaradan/home's own remote needs, so every machine gets it regardless.

Examples:
  MACHINE_OWNER=VIJAY curl -fsSL <hosted-url> | sh
  curl -fsSL <hosted-url> | MACHINE_OWNER=VIJAY sh
EOF
}

if [ -z "${MACHINE_OWNER+x}" ]; then
	echo "MACHINE_OWNER is not set." >&2
	machine_owner_usage
	exit 1
fi
_mo_norm="$(printf '%s' "$MACHINE_OWNER" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"
case "$_mo_norm" in
	VIJAY|WMG) ;;
	*)
		if [ -z "$_mo_norm" ]; then
			echo "MACHINE_OWNER is empty." >&2
		else
			echo "Invalid MACHINE_OWNER: '$MACHINE_OWNER'." >&2
		fi
		machine_owner_usage
		exit 1
		;;
esac
unset _mo_norm

case "$(uname -s)" in
	Darwin) OS=macos ;;
	Linux)  OS=linux ;;
	*) echo "Unsupported OS: $(uname -s). This covers macOS and Linux (Ubuntu) only so far." >&2; exit 1 ;;
esac

# -----------------------------------------------------------------------------
log "GitHub CLI"
# -----------------------------------------------------------------------------
if ! have gh; then
	case "$OS" in
	macos)
		if ! have brew; then
			echo "Homebrew is required. Install from https://brew.sh/ then re-run this script." >&2
			exit 1
		fi
		brew install gh
		;;
	linux)
		# Official apt install steps: https://github.com/cli/cli/blob/trunk/docs/install_linux.md
		sudo mkdir -p -m 755 /etc/apt/keyrings
		curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
			| sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
		sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
		sudo mkdir -p -m 755 /etc/apt/sources.list.d
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
			| sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
		sudo apt-get update -qq
		sudo apt-get install -y gh
		;;
	esac
fi

# -----------------------------------------------------------------------------
log "GitHub auth"
# -----------------------------------------------------------------------------
# The token goes in ~/.config/gh/hosts.yml (--insecure-storage), not the
# keyring: the dotfiles keep each GitHub account's login in its own config dir
# (ONBOARDING.md §4). Until the dotfiles are linked, git's global config is a
# throwaway file, so gh's git-credential setup can't create a real ~/.gitconfig
# that link-dotfiles would then refuse to replace.
GIT_CONFIG_GLOBAL="$(mktemp)"
export GIT_CONFIG_GLOBAL
if ! gh auth status -h github.com >/dev/null 2>&1; then
	echo "Not logged in. This opens a browser-based device-code flow."
	echo "Log in as your PERSONAL account, $PERSONAL_GH. If the browser is signed in to"
	echo "another account, switch accounts there (or use a private window) first."
	# the admin:* scopes let setup-github-ssh register the SSH keys without a
	# second browser authorization. With --skip-ssh-key (current gh) the login
	# asks nothing; older gh asks one question instead.
	if gh auth login --help 2>/dev/null | grep -q -- --skip-ssh-key; then
		gh auth login -h github.com --git-protocol ssh --skip-ssh-key --web --insecure-storage \
			-s admin:public_key,admin:ssh_signing_key
	else
		echo "If asked \"Authenticate Git with your GitHub credentials?\", answer Y: it only"
		echo "affects a temporary git config used for the clone below."
		gh auth login -h github.com --git-protocol https --web --insecure-storage \
			-s admin:public_key,admin:ssh_signing_key
	fi
fi
# This login is the personal gh login (~/.config/gh); any other account here
# would act as the wrong one everywhere.
_login="$(gh api user --jq .login 2>/dev/null || true)"
if [ "$_login" != "$PERSONAL_GH" ]; then
	echo "gh is logged in as '${_login:-nobody}', but this must be $PERSONAL_GH." >&2
	echo "Run: gh auth logout -h github.com${_login:+ -u $_login}   then re-run this script." >&2
	exit 1
fi
unset _login
gh auth setup-git -h github.com   # into the throwaway config, for the clone below

# -----------------------------------------------------------------------------
log "Clone dotfiles"
# -----------------------------------------------------------------------------
if [ -d "$DEST/.git" ]; then
	# Update it: everything below runs the dotfiles' own scripts, so a stale
	# clone (e.g. from an earlier, failed run) would run stale code.
	echo "Already present at $DEST; updating it."
	if [ -n "$(git -C "$DEST" status --porcelain)" ]; then
		echo "$DEST has uncommitted changes - commit or discard them, then re-run." >&2
		exit 1
	fi
	if ! git -C "$DEST" pull --ff-only; then
		echo "Couldn't fast-forward $DEST (local commits not on GitHub, or no access) - sort it out, then re-run." >&2
		exit 1
	fi
else
	# Explicit https:// URL, not the bare "owner/repo" shorthand: the whole
	# point is to clone via gh's authenticated HTTPS transport before any SSH
	# key exists, and the shorthand form instead uses whatever git_protocol is
	# already configured locally, which could be ssh and defeat that.
	gh repo clone "https://github.com/$REPO_GH" "$DEST"
fi

rm -f "$GIT_CONFIG_GLOBAL"
unset GIT_CONFIG_GLOBAL

# -----------------------------------------------------------------------------
log "Symlink dotfiles"
# -----------------------------------------------------------------------------
# Exits 1 if it had to skip a file it won't replace; reported at the end.
LINKS_OK=1
"$DEST/bin/link-dotfiles" || LINKS_OK=0

# -----------------------------------------------------------------------------
log "SSH keys and identities (personal / WMG)"
# -----------------------------------------------------------------------------
# After link-dotfiles: identities come from the linked .gitconfig files, and
# `gh` must resolve to the linked ~/bin/gh. It exits 1 while anything is
# unresolved (e.g. an Azure DevOps key not yet added on the website) - report
# that at the end instead of aborting the toolchain install.
IDENTITIES_OK=1
PATH="$HOME/bin:$PATH" "$DEST/bin/setup-github-ssh" || IDENTITIES_OK=0
# clones made by gh from now on use SSH (the keys are set up)
gh config set -h github.com git_protocol ssh

# -----------------------------------------------------------------------------
log "Install dev toolchain"
# -----------------------------------------------------------------------------
case "$OS" in
	macos) TOOLCHAIN_SCRIPT="$DEST/setup-dev-tools-macos.sh" ;;
	linux) TOOLCHAIN_SCRIPT="$DEST/setup-dev-tools-ubuntu.sh" ;;
esac
TOOLCHAIN_OK=1
"$TOOLCHAIN_SCRIPT" || TOOLCHAIN_OK=0

if [ "$LINKS_OK" = 1 ] && [ "$IDENTITIES_OK" = 1 ] && [ "$TOOLCHAIN_OK" = 1 ]; then
	log "Done. Open a fresh shell to pick up the new PATH."
	return 0
fi
log "Done, with problems:"
[ "$LINKS_OK" = 1 ] || echo "  - some dotfiles weren't linked (see the SKIP lines above): move those files aside, then run ~/.home/bin/link-dotfiles"
[ "$IDENTITIES_OK" = 1 ] || echo "  - identities need attention: open a fresh shell and run setup-github-ssh"
[ "$TOOLCHAIN_OK" = 1 ] || echo "  - the toolchain install failed (see the error above): fix it, then re-run $TOOLCHAIN_SCRIPT"
exit 1
}

if [ -r /dev/tty ] && : </dev/tty 2>/dev/null; then
	main "$@" </dev/tty
else
	main "$@" </dev/null   # no terminal (CI): prompts read EOF and decline
fi
